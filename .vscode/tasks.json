// See https://go.microsoft.com/fwlink/?LinkId=733558
// for the documentation about the tasks.json format
{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Compile SCSS",
      "type": "npm",
      "script": "compile-scss",
      "problemMatcher": {
        "owner": "sass",
        "source": "sass",
        "fileLocation": "relative",
        "pattern": {
          "regexp": "^\\s*(.+\\.scss)\\s+(\\d+):(\\d+)\\s+(.+)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4
        }
      },
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated"
      }
    },
    {
      "label": "Watch TS",
      "type": "npm",
      "script": "watch",
      "problemMatcher": "$tsc-watch",
      "isBackground": true,
      "presentation": {
        "reveal": "never"
      }
    },
    {
      "label": "Watch",
      "dependsOn": ["Compile SCSS", "Watch TS"],
      "dependsOrder": "sequence",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Watch unit tests",
      "type": "npm",
      "script": "test:unit:watch",
      "problemMatcher": []
    }
  ]
}
